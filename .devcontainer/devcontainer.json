{
  "name": "Retrovoxels",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      // engines.node in package.json, so this follows the repo
      "version": "25",
      "pnpmVersion": "latest"
    }
  },

  // Install and seed once, so the container is ready to `pnpm run dev`
  "postCreateCommand": "pnpm install && .devcontainer/setup-db.sh",

  // Set env var so psql knows which DB to connect to by default
  "containerEnv": {
    "PGDATABASE": "voxels",
    "PGHOST": "db", 
    "PGUSER": "postgres"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ckotzb.postgresql"]
    }
  }
}